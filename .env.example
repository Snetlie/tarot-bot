BOT_TOKEN=
# Публичный HTTPS-адрес мини-аппа (например, из cloudflared/ngrok или хостинга)
WEBAPP_URL=
PORT=8080

# LLM: anthropic (по умолчанию) или openai (любой OpenAI-совместимый API)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
